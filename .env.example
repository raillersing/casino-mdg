# ═══════════════════════════════════════════
# Casino MDG — Configuration complète
# ═══════════════════════════════════════════

# ─── Environnement ─────────────────────────
ENV=development
DEBUG=True

# ─── Django ──────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production-use-64-char-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ─── Database ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=casino_mdg
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Redis ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── RabbitMQ ────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# ─── Game Engine ─────────────────────────────
GAME_ENGINE_ADDR=:8080
JWT_SECRET=change-me-in-production

# ─── CORS ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Frontend ────────────────────────────────
BACKEND_PORT=8001
VITE_API_URL=http://localhost:8001/api/v1
VITE_WS_URL=ws://localhost:8080

# ─── Payment Providers (sandbox keys) ──────
MVOLA_API_KEY=test-mvola-key
ORANGE_MONEY_API_KEY=test-orange-key
AIRTEL_MONEY_API_KEY=test-airtel-key
PAYDUNYA_API_KEY=test-paydunya-key
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# ─── MinIO / S3 ────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=mg-antananarivo
MINIO_BUCKET_NAME=casino-mdg

# ─── Vault ───────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root

# ─── Monitoring ──────────────────────────────
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
PROMETHEUS_PORT=9090
GRAFANA_USER=admin
GRAFANA_PASS=admin

# ─── Email / Notifications ───────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@casino-mdg.mg
SMTP_PASS=change-me
TWILIO_ACCOUNT_SID=AC_xxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+261xxxxx

# ─── reCAPTCHA ───────────────────────────────
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# ─── Firebase (push notifications) ───────────
