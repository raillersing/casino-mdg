# ═══════════════════════════════════════════════════════════════
# Casino MDG — Variables d'Environnement de Production (Ubuntu VPS)
# Copiez ce fichier vers .env.production sur votre VPS Contabo :
#   cp .env.production.example .env.production
# ═══════════════════════════════════════════════════════════════

# ─── Environnement Général ────────────────────────────────────
ENV=production
DEBUG=False
PORT=80
SECURE_SSL_REDIRECT=True

# ─── Domaines & Hôtes Autorisés ──────────────────────────────
# Obligatoire : remplacer le domaine fictif ; ne jamais mettre '*' en production.
# Vérifier que le reverse proxy transmet X-Forwarded-Proto correctement.
# Lancer ensuite : python3 scripts/production_preflight.py --env-file .env.production
ALLOWED_HOSTS=YOUR_CASINO_DOMAIN.example.invalid
CORS_ALLOWED_ORIGINS=https://YOUR_CASINO_DOMAIN.example.invalid

# ─── Clés Secrètes de Sécurité (Générez via: openssl rand -hex 32) ───
DJANGO_SECRET_KEY=generate-strong-random-64-character-secret-key-here
JWT_SECRET=generate-strong-random-32-byte-jwt-secret-for-tokens
GAME_ENGINE_BOT_SECRET=generate-strong-random-bot-auth-secret
GAME_ENGINE_RESULT_SECRET=generate-strong-random-s2s-result-hmac-secret
PAYMENT_WEBHOOK_SECRET=generate-strong-random-webhook-secret-here

# ─── Base de Données PostgreSQL & PgBouncer ──────────────────
DB_NAME=casino_mdg
DB_USER=casino_user
DB_PASSWORD=generate-strong-database-password-here
DB_CONN_MAX_AGE=60

# ─── RabbitMQ & Celery ───────────────────────────────────────
RABBITMQ_USER=casino_broker
RABBITMQ_PASS=generate-strong-rabbitmq-password-here

# ─── Passerelles de Paiement Réelles (Production) ─────────────
# Complétez avec vos identifiants réels reçus des opérateurs
MVOLA_CLIENT_ID=
MVOLA_CLIENT_SECRET=
MVOLA_MERCHANT_NUMBER=

ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_KEY=

AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=

# ─── Monitoring & Alerting (Optionnel) ───────────────────────
SENTRY_DSN=

# ─── Authentification OTP — obligatoire pour les comptes par téléphone ───
# Configurer UN fournisseur SMS réel avant toute mise en production.
# Sans fournisseur fonctionnel, la demande de code renvoie HTTP 503, jamais le code OTP.
# Ne jamais activer un mode de renvoi de code dans les réponses API en production.
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
# Alternative Twilio :
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
