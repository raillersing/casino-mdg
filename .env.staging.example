# Copy to .env.staging (gitignored). These example values are NOT deployable secrets.
# Generate independent values: openssl rand -hex 32 (for each secret).
# Use alphanumeric/hex secrets (avoid URL-reserved characters in RabbitMQ password).
STAGING_PORT=18081
STAGING_ORIGIN=http://localhost:18081
STAGING_ALLOWED_HOSTS=localhost,127.0.0.1,backend
STAGING_DB_NAME=casino_mdg_staging
STAGING_DB_USER=casino_staging
STAGING_DB_PASSWORD=CHANGE_ME_DB
STAGING_RABBITMQ_USER=casino_staging_broker
STAGING_RABBITMQ_PASSWORD=CHANGE_ME_RABBIT
STAGING_DJANGO_SECRET_KEY=CHANGE_ME_DJANGO
STAGING_JWT_SECRET=CHANGE_ME_JWT
STAGING_ENGINE_BOT_SECRET=CHANGE_ME_ENGINE_BOT
STAGING_ENGINE_RESULT_SECRET=CHANGE_ME_ENGINE_RESULT
STAGING_PAYMENT_WEBHOOK_SECRET=CHANGE_ME_TO_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Off unless a sandbox provider sends signed test callbacks.
STAGING_PAYMENT_SANDBOX_WEBHOOKS_ENABLED=False
# Email sandbox; leave disabled until the staging SMTP provider works.
STAGING_EMAIL_OTP_ENABLED=False
STAGING_EMAIL_HOST=
STAGING_EMAIL_PORT=587
STAGING_EMAIL_HOST_USER=
STAGING_EMAIL_HOST_PASSWORD=
STAGING_EMAIL_USE_TLS=True
STAGING_EMAIL_USE_SSL=False
STAGING_DEFAULT_FROM_EMAIL=
# Optional SMS sandbox for real sign-in tests; never use production credentials.
STAGING_SMS_GATEWAY_URL=
STAGING_SMS_GATEWAY_API_KEY=
